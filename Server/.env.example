# Copy to .env and fill in. Empty values fall back to the defaults.
# Keep comments on their own lines: some tools do not strip inline comments.

# Public base URL; links look like {PUBLIC_URL}/{id}. Required.
PUBLIC_URL=https://drop.example.com
# Shared secret for the Mac app, at least 16 characters. Required.
# Generate one with: openssl rand -base64 32
API_TOKEN=

# Shown on drop pages and returned by /api/info.
SITE_NAME=XNotch Cloud

# Largest file in bytes (5 GiB).
MAX_FILE_SIZE=5368709120
# Lifetime in seconds when the app does not ask for one (1 day).
DEFAULT_EXPIRY=86400
# Longest allowed lifetime in seconds (30 days).
MAX_EXPIRY=2592000
# Characters in a drop id (6 to 32).
ID_LENGTH=8

# Per-client token buckets. PER_MINUTE refills continuously; BURST is the
# initial/maximum balance. Password posts also consume the public budget.
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_PUBLIC_BURST=60
RATE_LIMIT_PASSWORD_PER_MINUTE=10
RATE_LIMIT_PASSWORD_BURST=5
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_API_BURST=60
RATE_LIMIT_RELAY_PER_MINUTE=30
RATE_LIMIT_RELAY_BURST=20
# New IPs get 429 when the table is full; live clients are never evicted.
RATE_LIMIT_MAX_CLIENTS=10000
# Must cover every bucket's full refill time. Cleanup is incremental on requests.
RATE_LIMIT_IDLE_SECONDS=900
# Shared Argon2 creation/verification slots (1..64), with no waiting queue.
PASSWORD_CONCURRENCY=4
# Empty = socket peer identity only. Comma-separated literal IPs/CIDRs of
# controlled proxies; no hostnames or /0. Never trust arbitrary forwarded headers.
# The HTTPS overlay overrides this with its fixed Caddy IP (172.30.254.2).
TRUSTED_PROXIES=

# Storage: `local` (files in DATA_DIR, the /data volume) or `s3`.
STORAGE=local

# S3-compatible storage (AWS S3, Backblaze B2, Cloudflare R2, MinIO).
# Example for Backblaze B2:
# STORAGE=s3
# S3_BUCKET=my-xnotch-drops
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_ACCESS_KEY_ID=your-key-id
# S3_SECRET_ACCESS_KEY=your-application-key
# Optional folder inside the bucket:
# S3_PREFIX=xnotch

# Relay: lets the iPhone reach the Mac through this server when they are on
# different networks. `on` or `off`. Payloads are end-to-end encrypted by XNotch.
RELAY=on
# Largest relayed WebSocket message in bytes (8 MiB). Larger ones close the socket (1009).
RELAY_MAX_MESSAGE=8388608
# Connected phones (waiting or paired) at once.
RELAY_MAX_PAIRS=64
# Waiting Mac sockets across all rooms.
RELAY_MAX_WAITING=256
# Seconds a phone waits for a Mac before it is closed with 4404.
RELAY_PHONE_WAIT=10
# Seconds without any message before a pair is closed (30 minutes).
RELAY_IDLE_TIMEOUT=1800

# Logging: info or debug. Set LOG_FORMAT=json for JSON lines.
RUST_LOG=info
